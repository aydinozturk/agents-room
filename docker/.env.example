# agents-room Docker ekibi (isteğe bağlı). Ayarı konteynerin içinden "agents-room setup" ile de yapabilirsiniz.
# Bu dosyayı docker/.env olarak kopyalarsanız dolu değerler setup ayarının önüne geçer; .env git'e girmez.

# --- Masa (sunucu) ---
# Sunucunun ağdaki adresi. Sunucu aynı makinedeyse: http://host.docker.internal:7700
AGENTS_ROOM_SERVER=http://192.168.1.20:7700
# Sunucu makinesindeki server/data/enroll.secret dosyasının içeriği
AGENTS_ROOM_ENROLL_SECRET=
# Oturulacak oda; yoksa oluşturulur
AGENTS_ROOM_ROOM=urun-ekibi
AGENTS_ROOM_TOPIC=
# Kapalı bir odayı yeniden açmak için 1
REOPEN_ROOM=0

# --- Ortak repo ---
# Yeni oda için zorunlu; var olan odada odanın kayıtlı reposu kullanılır. Kısa yazım: org/proje
AGENTS_ROOM_REPO=
# Yalnızca bu repoya "Contents: Read and write" ve "Pull requests: Read and write" izni olan,
# süreli bir GitHub fine-grained token. Token adrese, oda kaydına ya da loglara yazılmaz.
AGENTS_ROOM_GIT_TOKEN=
# Token yerine SSH deploy key (compose.yaml'daki volume satırını da açın):
# AGENTS_ROOM_SSH_KEY=/run/secrets/deploy_key

# --- Ekip ---
# Bu makinedeki orkestratör sayısı ve platformları (virgülle). Orkestratör başka makinedeyse 0.
ORCHESTRATORS=0
ORCH_CLIENTS=claude
CLAUDE_WORKERS=2
CODEX_WORKERS=0
GEMINI_WORKERS=0
# Hermes için imajı INSTALL_HERMES=1 ile derleyin (deneysel)
HERMES_WORKERS=0
INSTALL_HERMES=0
# İlk hedef (orkestratör varsa). Boşsa panelden yazarsınız.
AGENTS_ROOM_GOAL=
# Sabit isimler (isteğe bağlı; boşsa rastgele insan isimleri, konteyner yeniden başlarsa aynıları kullanılır)
AGENT_NAMES=
# Agent başına saatte en fazla model oturumu (kaçak döngüye karşı koruma; 0 = sınırsız). Boştaki agent oturum açmaz.
SESSIONS=20
# Büyük repolar: git bu kadar saniye hiç ilerleme göstermezse indirme kesilir (toplam süre sınırı yok)
AGENTS_ROOM_GIT_STALL_SEC=300

# --- Model seçimi (boşsa: Claude claude-opus-5-5 / high, Codex gpt-5.6-sol / high; "default" → CLI'ın kendi varsayılanı) ---
CLAUDE_MODEL=
# low | medium | high | xhigh | max
CLAUDE_EFFORT=
CODEX_MODEL=
# low | medium | high | xhigh | max | ultra
CODEX_EFFORT=
GEMINI_MODEL=
# İzin düzeyi. full (konteynerde varsayılan): agent'lar her komutu sorgusuz çalıştırır (curl, python, docker…);
# sınır konteynerin kendisidir. restricted: yalnızca git, npm, npx, node, ls, mkdir, cat, gh, web araması/okuması.
AGENTS_ROOM_PERMISSIONS=
# restricted düzeyde Claude agent'larına ek izinler (Claude Code kural sözdizimi, ";" ile ayrılır), ör.: Bash(curl *elastic.example.com/*)
CLAUDE_ALLOWED_TOOLS=

# --- Model erişimi (yalnızca kullandığınız platformlar için) ---
# Anahtar vermek yerine tarayıcıyla bir kez giriş yapabilirsiniz; o zaman bu satırları boş bırakın:
#   docker compose -f docker/compose.yaml exec agents agents-room login claude|codex|gemini
# Claude Code: aboneliğiniz varsa "claude setup-token" çıktısı, yoksa API anahtarı
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Codex CLI
OPENAI_API_KEY=
# Gemini CLI
GEMINI_API_KEY=
# Hermes: OpenAI uyumlu model sunucusu (ör. LM Studio / vLLM). Ana makinedeyse host.docker.internal kullanın.
HERMES_BASE_URL=
HERMES_MODEL=
HERMES_API_KEY=
