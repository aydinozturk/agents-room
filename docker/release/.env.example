# agents-room hazır imaj ayarları (isteğe bağlı). Bu dosyayı compose dosyasının yanına .env olarak kopyalayın.
# Boş bırakılan değerler varsayılanı kullanır; agent ayarları konteynerin içinden "agents-room setup" ile de yapılabilir.

# --- Sürüm ---
# İki imajın etiketi. En yeni sürüm için: latest
AGENTS_ROOM_VERSION=0.3.1

# --- Sunucu (server.yaml, all-in-one.yaml) ---
AGENTS_ROOM_PORT=7700
# Yalnız bu makineden erişim için 127.0.0.1
AGENTS_ROOM_BIND=0.0.0.0
# Açılış mesajında gösterilecek adres, ör. http://192.168.1.20:7700
AGENTS_ROOM_PUBLIC_URL=
# Kayıt sırrı. server.yaml'da boşsa ilk açılışta üretilir; all-in-one.yaml'da zorunludur (openssl rand -hex 16).
# agents.yaml'da sunucunun sırrını buraya yazın: docker compose -f server.yaml exec server agents-room secret
AGENTS_ROOM_ENROLL_SECRET=

# --- Agent'lar: masa (agents.yaml) ---
# Sunucunun ağdaki adresi (all-in-one.yaml'da otomatik). Sunucu aynı makinede ayrı çalışıyorsa: http://host.docker.internal:7700
AGENTS_ROOM_SERVER=
# Oturulacak oda; yoksa oluşturulur
AGENTS_ROOM_ROOM=
AGENTS_ROOM_TOPIC=
# Kapalı bir odayı yeniden açmak için 1
REOPEN_ROOM=0

# --- Ortak repo ---
# Yeni oda için zorunlu; var olan odada odanın kayıtlı reposu kullanılır. Kısa yazım: org/proje
AGENTS_ROOM_REPO=
# Yalnızca bu repoya "Contents: Read and write" ve "Pull requests: Read and write" izni olan,
# süreli bir GitHub fine-grained token. Token adrese, oda kaydına ya da loglara yazılmaz.
AGENTS_ROOM_GIT_TOKEN=
# Token yerine SSH deploy key (agents.yaml'daki volume satırını da açın):
# AGENTS_ROOM_SSH_KEY=/run/secrets/deploy_key

# --- Ekip ---
# Bu makinedeki orkestratör sayısı ve platformları (virgülle). Orkestratör başka makinedeyse 0.
ORCHESTRATORS=0
ORCH_CLIENTS=claude
CLAUDE_WORKERS=2
CODEX_WORKERS=0
GEMINI_WORKERS=0
# Hazır imajda Hermes yok; kullanmak için imajı kaynaktan INSTALL_HERMES=1 ile derleyin (docs/docker.md)
HERMES_WORKERS=0
# İlk hedef (orkestratör varsa). Boşsa panelden yazarsınız.
AGENTS_ROOM_GOAL=
# Sabit isimler (isteğe bağlı; boşsa rastgele insan isimleri, konteyner yeniden başlarsa aynıları kullanılır)
AGENT_NAMES=
SESSIONS=20

# --- Model erişimi (yalnızca kullandığınız platformlar için) ---
# Anahtar vermek yerine tarayıcıyla bir kez giriş yapabilirsiniz; o zaman bu satırları boş bırakın:
#   docker compose -f agents.yaml exec agents agents-room login claude|codex|gemini
# Claude Code: aboneliğiniz varsa "claude setup-token" çıktısı, yoksa API anahtarı
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Codex CLI
OPENAI_API_KEY=
# Gemini CLI
GEMINI_API_KEY=
# Hermes: OpenAI uyumlu model sunucusu (ör. LM Studio / vLLM). Ana makinedeyse host.docker.internal kullanın.
HERMES_BASE_URL=
HERMES_MODEL=
HERMES_API_KEY=
