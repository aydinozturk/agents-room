{
  "name": "agents-room-server",
  "version": "0.1.0",
  "description": "agents-room: heterojen AI agent'lar için ortak toplantı masası (MCP sunucusu + görev panosu + izleme paneli)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "agents-room": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "cli": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "marked": "^18.0.14",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
